{
  "name": "@harness-plugins/grokbot-agent-loop",
  "description": "GrokBot Loop — interruptible dual-lane agent-loop plugin for DeepSeek Harness (community homage; not affiliated with xAI)",
  "version": "0.2.3",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scheduler": {
      "types": "./lib/scheduler.d.ts",
      "default": "./lib/scheduler.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "locale/*.json",
    "cordis.patch.yml",
    "examples/**/*.yml",
    "NOTICE",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "docs/**/*.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqlong17/grokbot-agent-loop.git"
  },
  "bugs": {
    "url": "https://github.com/jqlong17/grokbot-agent-loop/issues"
  },
  "homepage": "https://github.com/jqlong17/grokbot-agent-loop#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-loop",
    "grokbot"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/scheduler.spec.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live-parallel": "node scripts/live-parallel.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent-spawn-in-process": {
      "optional": true
    }
  }
}
